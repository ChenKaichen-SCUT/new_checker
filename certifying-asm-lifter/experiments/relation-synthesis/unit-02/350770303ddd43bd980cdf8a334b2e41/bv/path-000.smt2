(declare-fun input_n () (_ BitVec 32))
(declare-fun co_0 () (_ BitVec 2))
(declare-fun co_1 () (_ BitVec 2))
(declare-fun topo_U_0 () (_ BitVec 2))
(declare-fun topo_U_1 () (_ BitVec 2))
(declare-fun topo_T_0 () (_ BitVec 2))
(declare-fun topo_T_1 () (_ BitVec 2))
(declare-fun final_x () (_ BitVec 32))
(assert (= input_n input_n))
(assert true)
(assert (bvult co_0 #b10))
(assert (= co_0 #b00))
(assert (bvult co_1 #b10))
(assert (distinct co_0 co_1))
(assert (bvult topo_U_0 #b10))
(assert (bvult topo_U_1 #b10))
(assert (bvult topo_T_0 #b10))
(assert (bvult topo_T_1 #b10))
(assert (=> (or false false (bvult co_0 co_0) or) (bvult topo_U_0 topo_U_0)))
(assert (=> (or false false (bvult co_0 co_0) or (and false false))
    (bvult topo_T_0 topo_T_0)))
(assert (=> (or false false (bvult co_0 co_1) or) (bvult topo_U_0 topo_U_1)))
(assert (=> (or false false (bvult co_0 co_1) or (and true false))
    (bvult topo_T_0 topo_T_1)))
(assert (=> (or false false (bvult co_1 co_0) or) (bvult topo_U_1 topo_U_0)))
(assert (=> (or false false (bvult co_1 co_0) or (and true false))
    (bvult topo_T_1 topo_T_0)))
(assert (=> (or false false (bvult co_1 co_1) or) (bvult topo_U_1 topo_U_1)))
(assert (=> (or false false (bvult co_1 co_1) or (and false false))
    (bvult topo_T_1 topo_T_1)))
(assert (=> (= co_0 #b01) (= #x00000000 final_x)))
(assert (=> (= co_1 #b01) (= final_x input_n)))

(check-sat)
