(declare-fun input_b () Bool)
(declare-fun co_0 () (_ BitVec 1))
(declare-fun read_other () (_ BitVec 32))
(declare-fun rf_0_1 () Bool)
(declare-fun topo_U_0 () (_ BitVec 2))
(declare-fun topo_U_1 () (_ BitVec 2))
(declare-fun topo_T_0 () (_ BitVec 2))
(declare-fun topo_T_1 () (_ BitVec 2))
(declare-fun final_x () (_ BitVec 32))
(assert (= input_b input_b))
(assert true)
(assert (= input_b false))
(assert (bvult co_0 #b1))
(assert (= co_0 #b0))
(assert (distinct co_0))
(assert (=> rf_0_1 (= #x00000000 read_other)))
(assert ((_ pbeq 1 1) rf_0_1))
(assert (bvult topo_U_0 #b10))
(assert (bvult topo_U_1 #b10))
(assert (bvult topo_T_0 #b10))
(assert (bvult topo_T_1 #b10))
(assert (=> (or false false (bvult co_0 co_0) or) (bvult topo_U_0 topo_U_0)))
(assert (=> (or false false (bvult co_0 co_0) or (and false false))
    (bvult topo_T_0 topo_T_0)))
(assert (=> (or false rf_0_1 false or) (bvult topo_U_0 topo_U_1)))
(assert (=> (or false false false or (and true rf_0_1)) (bvult topo_T_0 topo_T_1)))
(assert (=> (or false false false (and rf_0_1 (bvult co_0 co_0)))
    (bvult topo_U_1 topo_U_0)))
(assert (=> (or false false false (and rf_0_1 (bvult co_0 co_0)) (and true false))
    (bvult topo_T_1 topo_T_0)))
(assert (=> (or false false false (and rf_0_1 false)) (bvult topo_U_1 topo_U_1)))
(assert (=> (or false false false (and rf_0_1 false) (and false false))
    (bvult topo_T_1 topo_T_1)))
(assert (=> (= co_0 #b0) (= #x00000000 final_x)))

(check-sat)
