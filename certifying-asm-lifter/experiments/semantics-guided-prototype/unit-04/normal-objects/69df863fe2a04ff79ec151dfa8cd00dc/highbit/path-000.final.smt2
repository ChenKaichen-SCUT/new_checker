(declare-fun input_n () (_ BitVec 32))
(declare-fun co_0 () (_ BitVec 1))
(declare-fun final_x () (_ BitVec 32))
(declare-fun k!3 () Bool)
(declare-fun topo_U_0 () (_ BitVec 1))
(declare-fun k!4 () Bool)
(declare-fun topo_T_0 () (_ BitVec 1))
(declare-fun k!5 () Bool)
(declare-fun k!6 () Bool)
(assert (= input_n input_n))
(assert (= #x80000000 input_n))
(assert (bvult co_0 #b1))
(assert (= co_0 #b0))
(assert (distinct co_0))
(assert (bvult topo_U_0 #b1))
(assert (bvult topo_T_0 #b1))
(assert (=> (or false false (bvult co_0 co_0) or) (bvult topo_U_0 topo_U_0)))
(assert (=> (or false false (bvult co_0 co_0) or (and false false))
    (bvult topo_T_0 topo_T_0)))
(assert (=> (= co_0 #b0) (= #x00000000 final_x)))
(assert (or (distinct #x80000000 input_n) (distinct #b0 co_0)))
(model-add input_n () (_ BitVec 32) #x80000000)
(model-add co_0 () (_ BitVec 1) #b0)
(model-add final_x () (_ BitVec 32) #x00000000)
(model-del k!3)
(model-add topo_U_0 () (_ BitVec 1) (ite k!3 #b1 (bvnot #b1)))
(model-del k!4)
(model-add topo_T_0 () (_ BitVec 1) (ite k!4 #b1 (bvnot #b1)))
(model-del k!5)
(model-add k!3 () Bool (not k!5))
(model-del k!6)
(model-add k!4 () Bool (not k!6))

(check-sat)
