# Downloaded toolchains, builds, and local execution caches.
/certifying-asm-lifter/vendor/
/certifying-asm-lifter/output/
# Gap45 raw trees hydrate from the byte-exact public CAS. Prior tracked
# registration evidence stays tracked; final human-readable tables are public.
/certifying-asm-lifter/experiments/gap45/*-*/
!/certifying-asm-lifter/experiments/gap45/summary-02/
!/certifying-asm-lifter/experiments/gap45/published-supplement/
/output/
**/__pycache__/
**/.pytest_cache/
*.py[cod]
*.native
*.o
*.class
*.bc
.venv/
venv/

# Literature downloads and original competition inputs remain local.
# Their inventories, hashes, audit results, and primary-source links are tracked.
/research/sources/
/research/svcomp/*
!/research/svcomp/summary.json
!/research/svcomp/audit.json
!/research/svcomp/rows.json

# Local credentials and editor/OS files.
.env
.env.*
*.pem
*.key
.DS_Store
Thumbs.db
.idea/
.vscode/
